.devtools/artifacts/
__pycache__/
.pytest_cache/
.DS_Store

# native modules build here (native/<crate>, an addon's native/)
native/*/target/
addons/*/native/target/

# the dev workbench's quicksave slots (named scenarios are kept)
.devtools/scenarios/*/quick_*.json

# reference material kept beside the repo, never committed
reference/**/*

# an experiment's results stay beside it, out of git
.devtools/experiments/*/results/
