// Sandcastle's entities for Hammer: the gamemode's own, and the TF2 classes it implements that
// Garry's Mod's FGDs do not declare. Load it after garrysmod.fgd (Hammer's game configuration:
// Game Data files). Each class's keyvalues, inputs and outputs are what its Lua reads and fires
// (addons/sandcastle/gamemodes/sandcastle/entities/entities/<class>.lua); tests/fgd_sandcastle_test.lua
// holds the two together.

@include "garrysmod.fgd"

// ---------------------------------------------------------------------------------------------
// Shared

@BaseClass = TFTeam
[
	TeamNum(choices) : "Team" : 0 : "The TF2 team this belongs to." =
	[
		0 : "Any"
		2 : "RED"
		3 : "BLU"
	]
]

@BaseClass = RoomClass
[
	class(choices) : "Room class" : "" : "What the room is for, over what the AI war finds; empty leaves it to the war." =
	[
		"" : "Found by the war"
		"restricted" : "Restricted (a team's spawn and what only it reaches)"
		"stronghold" : "Stronghold (a team's own ground)"
		"outpost" : "Outpost (a team's claim out on its own)"
		"highway" : "Highway (the way both teams go)"
		"commons" : "Commons (between the teams)"
		"unoccupied" : "Unoccupied (indoors, held by none)"
		"wilds" : "Wilds (outdoors, held by none)"
	]
]

// ---------------------------------------------------------------------------------------------
// Sandcastle's own

@PointClass base(Targetname, TFTeam, RoomClass) iconsprite("editor/info_target.vmt") = info_room :
	"A mapper's word on the room it stands in, which the AI war finds from the nav mesh: its name, " +
	"what it is for and who holds it. A room tied to a control point is held by the point's owner. " +
	"One to a room; what it leaves out is the war's to find."
[
	label(string) : "Label" : "" : "The room's name, shown on the rooms overlay and given with a squad's orders."
	controlpoint(target_destination) : "Control point" : "" : "A team_control_point whose owner holds the room, over Team."
]

@PointClass base(Targetname) iconsprite("editor/ambient_generic.vmt") = ent_room_alarm :
	"A room's alarm. The squad occupying the room raises it when its leader orders it to stack up, a " +
	"guard gone missing; the map may raise and quiet it too. Raised, it sounds its klaxon for its duration."
[
	sound(sound) : "Klaxon" : "ambient/alarms/alarm_citizen_loop1.wav" : "The looping sound it plays while raised."
	duration(float) : "Duration" : "20" : "How long it sounds once raised, in seconds."

	input Trigger(void) : "Raise the alarm."
	input Silence(void) : "Quiet it."

	output OnAlarm(void) : "Fired as it is raised."
	output OnSilenced(void) : "Fired as it is quieted."
]

// ---------------------------------------------------------------------------------------------
// TF2's, as the gamemode implements them

@SolidClass base(Targetname, TFTeam) = func_respawnroom :
	"A team's spawn room. Its team and whether it is active drive the func_respawnroomvisualizers that name it."
[
	StartDisabled(choices) : "Start Disabled" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]

	input Enable(void) : "Make it its team's spawn room."
	input Disable(void) : "Stop it being one."
	input SetTeam(integer) : "Give it to a team."
]

@SolidClass base(Targetname, TFTeam) = func_respawnroomvisualizer :
	"The forcefield over a spawn room's doors: it takes its func_respawnroom's team at round start, is on " +
	"while the room is active, and stops the room's enemies when set to."
[
	respawnroomname(target_destination) : "Respawn room" : "" : "The func_respawnroom it shows."
	solid_to_enemies(choices) : "Solid to enemies" : 1 =
	[
		0 : "No"
		1 : "Yes"
	]
	StartDisabled(choices) : "Start Disabled" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
]

@SolidClass base(Targetname, TFTeam) = func_regenerate :
	"A resupply locker's volume: a player of its team inside is resupplied, at most once every 3 seconds."
[
	associatedmodel(target_destination) : "Locker" : "" : "The locker prop it opens and closes."
]

@PointClass base(Targetname, TFTeam, Angles) studio("models/editor/playerstart.mdl") = info_player_teamspawn :
	"Where a player of its team spawns (the engine's entity; the gamemode reads its keyvalues)."
[
	controlpoint(target_destination) : "Control point" : "" : "Its team follows this point's owner."
	round_bluespawn(target_destination) : "BLU spawn in round" : "" : "A team_control_point_round in which it spawns BLU."
	round_redspawn(target_destination) : "RED spawn in round" : "" : "A team_control_point_round in which it spawns RED."
	SpawnMode(choices) : "Spawn mode" : 0 =
	[
		0 : "Normal"
		1 : "Triggered (a respawn override's only)"
	]
	StartDisabled(choices) : "Start Disabled" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
]

@FilterClass base(BaseFilter, TFTeam) = filter_activator_tfteam :
	"Passes entities of its team (fails them when negated). With a control point, its team is the point's owner."
[
	controlpoint(target_destination) : "Control point" : "" : "Take the team from this point's owner."
]

@BaseClass base(TFTeam) = BotHint
[
	StartDisabled(choices) : "Start Disabled" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]

	input Enable(void) : "Offer it to builders."
	input Disable(void) : "Withdraw it."
	input Toggle(void) : "Offer or withdraw it."
	input SetTeam(integer) : "Give it to a team."
]

@PointClass base(Targetname, BotHint, Angles) studio("models/buildables/sentry1.mdl") = bot_hint_sentrygun :
	"Where a support sets up a sentry gun, facing as it faces."
[
	output OnSentryGunDestroyed(void) : "Fired when the sentry built here is destroyed (never, yet)."
]

@PointClass base(Targetname, BotHint, Angles) studio("models/buildables/teleporter.mdl") = bot_hint_teleporter_exit :
	"Where a support sets up its teleporter's exit, facing as it faces."
[
]

@PointClass base(Targetname, BotHint, Angles) studio("models/buildables/dispenser.mdl") = bot_hint_engineer_nest :
	"Where a support settles: its sentry, dispenser and teleporter exit about this point."
[
]
