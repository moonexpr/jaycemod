{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.workbench/bin/check/check_lua_gate.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__github__issue_read",
      "Bash(llvm-objdump *)",
      "mcp__github__pull_request_read",
      "Bash(nm *)",
      "Bash(git push origin HEAD:main)"
    ]
  }
}
